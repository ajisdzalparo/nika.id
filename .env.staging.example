# ─────────────────────────────────────────────────────────────────────────────
# SatuMoment · STAGING
# Copy to `.env.staging` on the staging server. A production-like copy for testing before release:
# own domain, own database and bucket, Midtrans SANDBOX, real email delivery.
# Run:  docker compose --env-file .env.staging -f docker-compose.prod.yml up -d
# Never commit the real `.env.staging`.
# ─────────────────────────────────────────────────────────────────────────────

# Tells docker-compose.prod.yml to load this file into the app container
APP_ENV_FILE=".env.staging"

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://staging.satumoment.com"
BETTER_AUTH_URL="https://staging.satumoment.com"

# ── Database (separate from production!) ─────────────────────────────────────
POSTGRES_USER="satumoment_staging"
POSTGRES_PASSWORD=""           # REQUIRED: long random password
POSTGRES_DB="satumoment_staging"
# Containers reach Postgres by service name inside the compose network
DATABASE_URL="postgresql://satumoment_staging:<POSTGRES_PASSWORD>@postgres:5432/satumoment_staging"
POSTGRES_PUBLIC_PORT="5435"
SKIP_DB_MIGRATE="false"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Different from production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Google: add <BETTER_AUTH_URL>/api/auth/callback/google as an authorized redirect URI
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Staging Admin"

# ── Email ────────────────────────────────────────────────────────────────────
# Same mailbox as production is fine; the display name makes staging mail easy to spot.
SMTP_HOST=""                   # "Outgoing Server" from the mail host
SMTP_PORT="465"
SMTP_USER=""                   # e.g. admin@satumoment.com
SMTP_PASS=""
EMAIL_FROM=""
EMAIL_FROM_NAME="SatuMoment Staging"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── File storage ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT="minio"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""            # REQUIRED
MINIO_SECRET_KEY=""            # REQUIRED: long random secret
MINIO_BUCKET="uploads-staging"
MINIO_PUBLIC_URL="https://files-staging.satumoment.com"
MINIO_SKIP_TLS_VERIFY="false"

# ── Payments: SANDBOX only ───────────────────────────────────────────────────
# Sandbox keys from https://dashboard.sandbox.midtrans.com (SB-Mid-server-..., SB-Mid-client-...)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MANUAL_PAYMENT_BANKS="BCA|0000000000|STAGING - JANGAN TRANSFER"
MANUAL_PAYMENT_WHATSAPP=""
MANUAL_PAYMENT_QRIS_IMAGE=""

# ── AI ───────────────────────────────────────────────────────────────────────
# A separate OpenRouter key with a low credit limit keeps test usage apart from production
OPENROUTER_API_KEY=""
OPENROUTER_DESIGN_MODEL="anthropic/claude-sonnet-5.5"
OPENROUTER_CHAT_MODEL="anthropic/claude-haiku-4.5"
# Template similarity / originality checks (run often): keep this a cheap model
OPENROUTER_CHECK_MODEL="anthropic/claude-haiku-5.5"
