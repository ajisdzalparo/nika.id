# ─────────────────────────────────────────────────────────────────────────────
# SatuMoment environment template
# Copy to `.env` for local development (and `.env.prod` on the server), then fill in the blanks.
# Never commit the real `.env` / `.env.prod`.
# ─────────────────────────────────────────────────────────────────────────────

# ── App URLs ─────────────────────────────────────────────────────────────────
# Public URL of the app. Used in emails, auth callbacks and share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Usually the same as NEXT_PUBLIC_APP_URL
BETTER_AUTH_URL="http://localhost:3000"

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local: `docker compose up -d postgres` (container satumoment-postgres on port 5433)
DATABASE_URL="postgresql://nikaid:nikaid_password@localhost:5433/nikaid"

# Only read by docker-compose.prod.yml (the Postgres container on the server)
POSTGRES_USER="nikaid"
POSTGRES_PASSWORD=""           # REQUIRED in production: use a long random password
POSTGRES_DB="nikaid"
# Host port Postgres is published on. Prefer not exposing it publicly at all.
POSTGRES_PUBLIC_PORT="5434"
# Set to "true" to skip `db-migrate` when the app container starts
SKIP_DB_MIGRATE="false"

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Google sign-in (optional). Set NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="true" once the credentials exist.
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"

# First admin account, created/updated on startup when both are set (optional)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"

# ── Email (account activation, password reset) ───────────────────────────────
# Option A (recommended): SMTP of the domain mailbox, e.g. admin@satumoment.com.
# Take the values from your mail host's "Mail client configuration" page, "Outgoing Server" row.
# Port 465 = SSL/TLS, 587 = STARTTLS (SMTP_SECURE only overrides that guess).
SMTP_HOST=""                   # e.g. the outgoing server hostname, such as mail.example.com
SMTP_PORT="465"
SMTP_USER=""                   # full mailbox address, e.g. admin@satumoment.com
SMTP_PASS=""                   # the mailbox password (not the hosting panel password)
# SMTP_SECURE="true"

# Option B (used only when SMTP_HOST is empty): Gmail with a 16-character App Password
# from https://myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Sender shown to recipients. EMAIL_FROM defaults to SMTP_USER (or GMAIL_USER).
EMAIL_FROM=""
EMAIL_FROM_NAME="SatuMoment"
# With neither option set, activation/reset links are printed to the server console (dev only).

# ── File storage (S3-compatible: MinIO, AWS S3, Cloudflare R2, ...) ──────────
# Local: `docker compose up -d minio`, console at http://localhost:9001
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="nikaid-local"
MINIO_SECRET_KEY="nikaid-local-secret"
MINIO_BUCKET="uploads"
# Public base URL for uploaded files; files resolve to <MINIO_PUBLIC_URL>/<bucket>/<file>
MINIO_PUBLIC_URL="http://localhost:9000"
# Only for servers whose TLS chain Node does not trust
MINIO_SKIP_TLS_VERIFY="false"

# ── Payments ─────────────────────────────────────────────────────────────────
# Midtrans. Values saved in the admin panel (/admin/pengaturan-admin) override these.
# Notification URL in the Midtrans dashboard: <NEXT_PUBLIC_APP_URL>/api/payment/notification
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Manual transfer for plan upgrades. Format: "Bank|Number|Account holder;Bank|Number|Account holder"
MANUAL_PAYMENT_BANKS="BCA|1234567890|Nama Pemilik Rekening"
# WhatsApp for payment questions (international format, digits only, e.g. 6281234567890)
MANUAL_PAYMENT_WHATSAPP=""
# Public URL of a QRIS image shown on the manual payment page (optional)
MANUAL_PAYMENT_QRIS_IMAGE=""

# ── AI (Desain AI + support chat) via OpenRouter ─────────────────────────────
OPENROUTER_API_KEY=""          # sk-or-v1-...
OPENROUTER_DESIGN_MODEL="anthropic/claude-sonnet-4.5"
OPENROUTER_CHAT_MODEL="anthropic/claude-haiku-4.5"

# ── CI/CD (GitHub Actions) ───────────────────────────────────────────────────
# Not read from this file: set VPS_HOST, VPS_USER, VPS_PORT, VPS_SSH_KEY (and optionally
# DOKPLOY_WEBHOOK / COOLIFY_WEBHOOK / COOLIFY_TOKEN) as repository secrets on GitHub.
