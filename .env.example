DATABASE_URL="postgresql://user:password@localhost:5432/nikaid"
BETTER_AUTH_SECRET="your-secret-key-here-change-this-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (set NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true when you have credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"

# Email Service (Gmail SMTP)
# GMAIL_APP_PASSWORD is a 16-char App Password from https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Leave empty in dev to print verification links to the console.
GMAIL_USER="your-account@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM_NAME="SatuMoment"

# App URL for emails (production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional auto-seed admin on startup (recommended for initial production deploy)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"

# Storage (S3-compatible: MinIO, AWS S3, Cloudflare R2, ...)
# Local: `docker compose up -d minio`, console at http://localhost:9001
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="nikaid-local"
MINIO_SECRET_KEY="nikaid-local-secret"
MINIO_BUCKET="uploads"
# Public base URL for uploaded files (CDN or bucket host); files resolve to <MINIO_PUBLIC_URL>/<bucket>/<file>
MINIO_PUBLIC_URL="http://localhost:9000"
# Only for servers whose TLS chain Node does not trust
MINIO_SKIP_TLS_VERIFY="false"

# Manual transfer (upgrade paket). Format: "Bank|Nomor|Atas nama;Bank|Nomor|Atas nama"
MANUAL_PAYMENT_BANKS="BCA|1234567890|Nama Pemilik Rekening"
# Optional WhatsApp number for payment questions (international format, digits only)
MANUAL_PAYMENT_WHATSAPP=""

# OpenRouter AI (Desain AI + Chat Support AI)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_DESIGN_MODEL="anthropic/claude-sonnet-4.5"
OPENROUTER_CHAT_MODEL="anthropic/claude-haiku-4.5"
