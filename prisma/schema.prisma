generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  SILVER
  GOLD
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  Boolean   @default(false)
  name           String?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invitationSlug String?   @unique
  partnerName    String?
  weddingDate    DateTime?
  role           String    @default("USER")
  banned         Boolean   @default(false)
  views          Int       @default(0)
  templateSlug   String?
  plan           Plan      @default(FREE)
  planExpiresAt  DateTime? // Null means forever (for Gold) or not set? No, Free has 7 days.
  // Actually, for Free, when does it start? on Creation?
  // I'll assume planExpiresAt is strictly for when the *active period* ends.

  activeAiDesignId String?

  accounts     Account[]
  aiDesigns    AiDesign[]
  guests       Guest[]
  messages     GuestMessage[]
  invitation   Invitation?
  rsvps        RSVP[]
  sessions     Session[]
  transactions Transaction[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  accessToken          String?   @db.Text
  refreshToken         String?   @db.Text
  idToken              String?   @db.Text
  accessTokenExpiresAt DateTime?
  scope                String?
  expiresAt            DateTime?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Invitation {
  id        String   @id @default(cuid())
  userId    String   @unique
  isPublic  Boolean  @default(true)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guest {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RSVP {
  id         String   @id @default(cuid())
  userId     String
  guestName  String
  attendance String
  guests     Int      @default(1)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GuestMessage {
  id        String   @id @default(cuid())
  userId    String
  guestName String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  snapToken     String?
  plan          String? // FREE, SILVER, GOLD
  paymentProof  String? // URL to the uploaded image (for manual)
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AiDesign {
  id        String   @id @default(cuid())
  userId    String
  source    String   @default("AI") // AI (counts toward quota) | CATALOG (picked from the template catalog)
  prompt    String   @db.Text
  theme     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Template catalog managed from the admin CMS.
model CatalogTemplate {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String   @default("")
  category      String
  tier          String   @default("Gratis") // Gratis | Premium
  kind          String   @default("ENGINE") // ENGINE: theme JSON rendered by the AI theme engine; CODE: component in components/templates
  theme         Json?
  componentSlug String?
  thumbnail     String?
  referenceUrl  String? // inspiration note for admins, never shown publicly
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  isNew         Boolean  @default(false)
  sortOrder     Int      @default(0)
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}
