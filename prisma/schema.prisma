generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  HEMAT
  PREMIUM
  EKSKLUSIF
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  name            String?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invitationSlug  String?   @unique
  partnerName     String?
  weddingDate     DateTime?
  role            String    @default("USER")
  banned          Boolean   @default(false)
  // Better Auth admin plugin (ban details); required by its schema check since better-auth 1.7
  banReason       String?
  banExpires      DateTime?
  views           Int       @default(0)
  templateSlug    String?
  plan            Plan      @default(FREE)
  planExpiresAt   DateTime?
  extraGuestQuota Int       @default(0)
  aiCredits       Int       @default(0)

  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("UserReferrals")

  accountType          String    @default("PERSONAL") // PERSONAL | AGENCY
  agencyName           String?
  agencyWhatsapp       String?
  agencyInstagram      String?
  agencyLogo           String?
  agencyVerified       Boolean   @default(false)
  agencyQuota          Int       @default(0)
  agencyQuotaExpiresAt DateTime?

  activeAiDesignId String?

  accounts            Account[]
  aiDesigns           AiDesign[]
  guests              Guest[]
  messages            GuestMessage[]
  invitations         Invitation[]
  rsvps               RSVP[]
  sessions            Session[]
  supportThread       SupportThread?
  feedbacks           Feedback[]
  testimonial         Testimonial?
  surveys             SurveyResponse[]
  marketplaceInterest MarketplaceInterest?
  mitraApplications   MitraApplication[]
  invitationAccess    InvitationMember[]
  transactions        Transaction[]
  ledgerEntries       LedgerEntry[]
  withdrawals         WithdrawalRequest[]
  createdTemplates    CatalogTemplate[]    @relation("CreatedTemplates")
  templatePurchases   TemplatePurchase[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  token          String   @unique
  // Better Auth admin plugin: id of the admin impersonating this session
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  expiresAt             DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Invitation {
  id                String             @id @default(cuid())
  members           InvitationMember[]
  userId            String
  slug              String?            @unique
  title             String             @default("Undangan Pernikahan")
  weddingDate       DateTime?
  templateSlug      String?
  activeAiDesignId  String?
  plan              Plan               @default(FREE)
  planExpiresAt     DateTime?
  extraGuestQuota   Int                @default(0)
  views             Int                @default(0)
  isPublic          Boolean            @default(true)
  data              Json               @default("{}")
  clientName        String?
  clientWhatsapp    String?
  clientEditToken   String?            @unique
  /// Mitra sales report: what the mitra charged the client, what activating cost the mitra, and when it went live
  clientPrice       Int?
  mitraCost         Int?
  activatedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests            Guest[]
  rsvps             RSVP[]
  messages          GuestMessage[]
  transactions      Transaction[]
  visitLogs         InvitationVisit[]
  templatePurchases TemplatePurchase[]

  @@index([userId])
}

model InvitationVisit {
  id           String     @id @default(cuid())
  invitationId String
  device       String     @default("mobile") // "mobile" | "desktop"
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([invitationId, createdAt])
}

model Guest {
  id            String      @id @default(cuid())
  userId        String
  invitationId  String?
  name          String
  recipientType String      @default("PERSONAL") // PERSONAL | GROUP
  guestType     String      @default("REGULAR") // REGULAR | VIP
  greeting      String? // e.g. Bapak/Ibu, Yth., Saudara/i, Dear
  phone         String? // international digits, e.g. 6281234567890
  label         String? // e.g. Keluarga, Teman Kantor, Blast, Manual
  maxGuests     Int         @default(1)
  rsvpEnabled   Boolean     @default(true)
  eventName     String? // e.g. Umum, Akad Nikah, Resepsi, Livestream
  note          String?
  sentAt        DateTime? // when invitation link was sent/copied to this guest
  openedAt      DateTime? // first time this guest opened the web invitation in a real browser
  lastOpenedAt  DateTime? // most recent time this guest opened the web invitation
  openCount     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation    Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invitationId])
  @@index([invitationId, label])
}

model RSVP {
  id           String      @id @default(cuid())
  userId       String
  invitationId String?
  guestName    String
  attendance   String
  guests       Int         @default(1)
  phone        String? // international digits, e.g. 6281234567890
  companions   String? // names of the people coming along
  customAnswer String? // answer to the couple's own RSVP question
  note         String? // the couple's own note, e.g. a table number
  checkInToken String?     @unique // secret in the guest's QR code
  checkedInAt  DateTime? // scanned (or marked) at the venue
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invitationId])
}

model GuestMessage {
  id           String      @id @default(cuid())
  userId       String
  invitationId String?
  guestName    String
  message      String
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invitationId])
  @@index([status])
}

model Transaction {
  id               String      @id @default(cuid())
  userId           String
  invitationId     String?
  amount           Int
  status           String      @default("PENDING") // PENDING, SUCCESS, FAILED
  kind             String      @default("PLAN") // PLAN | GUEST_ADDON | AI_CREDIT | AGENCY_QUOTA | MARKETPLACE
  addonUnits       Int         @default(0)
  snapToken        String?
  plan             String? // HEMAT, PREMIUM, EKSKLUSIF
  templateId       String?
  referralCodeUsed String?
  promoCodeUsed    String?
  discountAmount   Int         @default(0)
  paymentProof     String? // URL to the uploaded image (for manual)
  paymentMethod    String?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation       Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invitationId])
  @@index([status])
}

model AiDesign {
  id              String   @id @default(cuid())
  userId          String
  source          String   @default("AI") // AI (counts toward quota) | CATALOG (picked from the template catalog)
  prompt          String   @db.Text
  theme           Json
  creditsUsed     Int      @default(1)
  planCreditsUsed Int      @default(1)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Template catalog managed from the admin CMS.
model CatalogTemplate {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  description    String             @default("")
  category       String
  tier           String             @default("Gratis") // Gratis | Premium
  kind           String             @default("ENGINE") // ENGINE: theme JSON rendered by the AI theme engine; CODE: component in components/templates
  theme          Json?
  defaultMusic   Json? // { type: "youtube" | "upload", url: string, title?: string }
  componentSlug  String?
  thumbnail      String?
  referenceUrl   String? // inspiration note for admins, never shown publicly
  isActive       Boolean            @default(true)
  isFeatured     Boolean            @default(false)
  isNew          Boolean            @default(false)
  sortOrder      Int                @default(0)
  usageCount     Int                @default(0)
  creatorId      String?
  creator        User?              @relation("CreatedTemplates", fields: [creatorId], references: [id], onDelete: SetNull)
  price          Int                @default(0) // 0 = included in plan; > 0 = paid Marketplace template
  platformFeePct Int                @default(30) // Owner commission % per sale
  reviewStatus   String             @default("APPROVED") // PENDING_REVIEW | APPROVED | REJECTED
  reviewNote     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  purchases      TemplatePurchase[]

  @@index([isActive, sortOrder])
  @@index([creatorId])
  @@index([reviewStatus])
}

/// Paid template license: one purchase unlocks one Marketplace template for one invitation.
model TemplatePurchase {
  id            String          @id @default(cuid())
  userId        String
  invitationId  String
  templateId    String
  transactionId String?         @unique
  price         Int
  platformFee   Int
  creatorShare  Int
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation    Invitation      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  template      CatalogTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([invitationId, templateId])
  @@index([userId])
  @@index([templateId])
}

/// Default background music presets curated and toggled by superadmin.
model DefaultMusic {
  id        String   @id @default(cuid())
  title     String
  artist    String   @default("")
  type      String   @default("upload") // youtube | upload
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  audience  String // "USER" | "ADMIN" | "ALL_USERS"
  userId    String? // targeted user ID when audience = "USER"
  type      String // "TEMPLATE" | "TRANSACTION" | "RSVP" | "SYSTEM"
  title     String
  message   String
  href      String?
  createdAt DateTime @default(now())

  reads NotificationRead[]

  @@index([audience, userId, createdAt])
  @@index([createdAt])
}

model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}

model SupportThread {
  id            String           @id @default(cuid())
  userId        String           @unique
  mode          String           @default("AI") // "AI" | "ADMIN"
  status        String           @default("OPEN") // "OPEN" | "RESOLVED"
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]

  @@index([mode, lastMessageAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  sender    String // "USER" | "AI" | "ADMIN" | "SYSTEM"
  content   String        @db.Text
  createdAt DateTime      @default(now())
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Money ledger: one row per movement. Platform revenue rows have userId = null.
/// Balances are sums of `amount` (rupiah; positive = credit, negative = debit).
model LedgerEntry {
  id            String    @id @default(cuid())
  /// Idempotency key, e.g. "revenue:<transactionId>", so retries never double-book
  key           String?   @unique
  /// PLATFORM_REVENUE (money received by the platform) | USER_EARNINGS (money owed to a user)
  account       String
  /// PAYMENT_RECEIVED | COMMISSION | SALE_SHARE | WITHDRAWAL | WITHDRAWAL_REVERSAL | ADJUSTMENT
  type          String
  /// What was sold: PLAN | GUEST_ADDON | AI_CREDIT | AGENCY_QUOTA | MARKETPLACE | ...
  source        String?
  amount        Int
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactionId String?
  withdrawalId  String?
  /// User earnings can be withdrawn only after this moment (refund holding period)
  availableAt   DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([account, createdAt])
  @@index([userId, account])
  @@index([transactionId])
}

/// A user's request to withdraw earnings (commissions, template sales).
model WithdrawalRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  /// BANK | EWALLET
  method        String
  /// Bank or e-wallet name, e.g. BCA, GoPay
  provider      String
  accountNumber String
  accountName   String
  /// PENDING | PAID | REJECTED
  status        String    @default("PENDING")
  adminNote     String?
  proofUrl      String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

/// Product feedback from users: feature requests, bug reports, ratings of existing features.
model Feedback {
  id           String    @id @default(cuid())
  userId       String
  invitationId String?
  category     String // SARAN | MASALAH | FITUR_BARU | PUJIAN
  feature      String // EDITOR | DESAIN | TAMU | RSVP | PEMBAYARAN | MITRA | DOMPET | LAINNYA
  rating       Int? // 1–5, how satisfied with that feature
  message      String    @db.Text
  pagePath     String?
  status       String    @default("BARU") // BARU | DITINJAU | DIRENCANAKAN | SELESAI | DITOLAK
  adminReply   String?   @db.Text
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// A couple's public review ("Apa kata mereka"). Shown on the landing page only after an admin approves it.
model Testimonial {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String // e.g. "Arif & Sarah"
  city        String?
  rating      Int // 1–5
  message     String    @db.Text
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote   String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, approvedAt])
}

/// Admin-managed discount codes typed at checkout ("Kode promo").
model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  description  String?
  percentOff   Int? // 1–100; either percentOff or amountOff (100 = free order, e.g. a mitra trial)
  amountOff    Int? // fixed rupiah off
  maxDiscount  Int? // cap for percentOff
  appliesTo    String    @default("ALL") // ALL or comma list of PLAN,GUEST_ADDON,AI_CREDIT,AGENCY_QUOTA
  minPurchase  Int       @default(0)
  maxUses      Int? // total redemptions; null = unlimited
  perUserLimit Int       @default(1)
  usedCount    Int       @default(0)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  /// Only this account may use the code (a mitra's trial code); null = anyone
  forUserId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Short periodic customer survey shown on the dashboard. "DITUNDA" rows record a "Nanti saja" so the
/// survey can back off; "TERKIRIM" rows hold the answers.
model SurveyResponse {
  id          String   @id @default(cuid())
  userId      String
  status      String // TERKIRIM | DITUNDA
  recommend   Int? // 0–10, likelihood to recommend (NPS)
  source      String? // where they heard about us
  designScore Int? // 1–5
  easeScore   Int? // 1–5
  priceScore  Int? // 1–5
  wish        String?  @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Interest survey shown while the template marketplace is "Segera hadir" (one answer per user, editable)
model MarketplaceInterest {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      String // BELI | JUAL | KEDUANYA | TIDAK
  priceBand String? // UNDER_25 | 25_50 | 50_100 | OVER_100: what they would pay / charge for one template
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
}

/// Request to join the Mitra program (landing page form or /mitra). Only an admin turns an account into a mitra.
model MitraApplication {
  id            String    @id @default(cuid())
  userId        String? // linked account (set when submitted while logged in, or matched by email on approval)
  name          String
  email         String
  whatsapp      String
  applicantType String    @default("USAHA") // USAHA | PERORANGAN
  businessName  String?
  businessKind  String? // WO | MUA | FOTO | PERCETAKAN | LAINNYA
  instagram     String?
  city          String?
  note          String?   @db.Text
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote     String?   @db.Text
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
}

/// Extra account with access to an invitation besides its owner: the client of a mitra sees their own
/// guests, RSVP, wishes and check-in, while the mitra (owner) keeps full access.
model InvitationMember {
  id           String     @id @default(cuid())
  invitationId String
  userId       String
  role         String     @default("CLIENT") // CLIENT
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([invitationId, userId])
  @@index([userId])
}
