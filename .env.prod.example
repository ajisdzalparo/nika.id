# ─────────────────────────────────────────────────────────────────────────────
# SatuMoment · PRODUCTION
# Copy to `.env.prod` and keep it on the VPS next to docker-compose.prod.yml.
# Run:  docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# Every value marked REQUIRED must be a real, long, random secret. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

# Tells docker-compose.prod.yml to load this file into the app container
APP_ENV_FILE=".env.prod"

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://satumoment.com"
BETTER_AUTH_URL="https://satumoment.com"

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER="nikaid"         # keep the existing role name of the live database
POSTGRES_PASSWORD=""           # REQUIRED
POSTGRES_DB="nikaid"           # keep the existing database name (renaming it hides the data)
DATABASE_URL="postgresql://nikaid:<POSTGRES_PASSWORD>@postgres:5432/nikaid"
# Avoid publishing Postgres to the internet; leave it bound to localhost if a port is needed.
POSTGRES_PUBLIC_PORT="127.0.0.1:5434"
SKIP_DB_MIGRATE="false"

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=""          # REQUIRED: openssl rand -base64 32 (changing it signs everyone out)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="true"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=""                   # REQUIRED: "Outgoing Server" from the mail host
SMTP_PORT="465"
SMTP_USER="admin@satumoment.com"
SMTP_PASS=""                   # REQUIRED: mailbox password
EMAIL_FROM=""
EMAIL_FROM_NAME="SatuMoment"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── File storage ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT="minio"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""            # REQUIRED
MINIO_SECRET_KEY=""            # REQUIRED
MINIO_BUCKET="uploads"
MINIO_PUBLIC_URL="https://files.satumoment.com"
MINIO_SKIP_TLS_VERIFY="false"

# ── Payments: LIVE ───────────────────────────────────────────────────────────
# Production keys from https://dashboard.midtrans.com (Mid-server-..., Mid-client-...)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="true"
MANUAL_PAYMENT_BANKS=""        # "Bank|Number|Account holder;..."
MANUAL_PAYMENT_WHATSAPP=""
MANUAL_PAYMENT_QRIS_IMAGE=""

# ── AI ───────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_DESIGN_MODEL="anthropic/claude-sonnet-5.5"
OPENROUTER_CHAT_MODEL="anthropic/claude-haiku-4.5"
# Template similarity / originality checks (run often): keep this a cheap model
OPENROUTER_CHECK_MODEL="anthropic/claude-haiku-5.5"
